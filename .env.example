# zw-ai – Konfiguration. Kopieren zu ".env" und ausfüllen:
#   cp .env.example .env
# Die ".env" wird nicht eingecheckt (.gitignore). scripts/start.sh lädt sie.

# ── Modellanbieter (Entwicklung): Gemini über den OpenAI-kompatiblen Endpunkt ──
# Kostenlosen Key holen: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Open WebUI seedet beim Start eine OpenAI-Verbindung aus diesen beiden Werten.
# Base-URL muss exakt auf /v1beta/openai/ enden.
OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Wird in start.sh auf GEMINI_API_KEY gesetzt – hier nichts eintragen.
OPENAI_API_KEY=

# ── Open WebUI ──
# Datenverzeichnis (SQLite usw.) im Repo, wird gitignored.
DATA_DIR=./data
# Port der Weboberfläche.
PORT=8080
# Eigener Login von Open WebUI an (erster registrierter Nutzer wird Admin).
WEBUI_AUTH=true
# Fester Secret-Key, damit Sitzungen einen Neustart überleben.
# Einmal erzeugen mit:  openssl rand -hex 32
WEBUI_SECRET_KEY=
