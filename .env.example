# zw-ai – Konfiguration. Kopieren zu ".env" und ausfüllen:
#   cp .env.example .env
# Die ".env" wird nicht eingecheckt (.gitignore). scripts/start.sh lädt sie.

# ── Modellanbieter: OpenAI-kompatible Verbindungen ──
# Mehrere Anbieter nebeneinander. URLs und Keys jeweils mit ';' trennen,
# die Reihenfolge muss übereinstimmen (1. URL ↔ 1. Key, 2. URL ↔ 2. Key).
# Open WebUI zeigt dann ALLE Modelle gemeinsam im Dropdown.
#   - Gemini: https://aistudio.google.com/apikey
#   - Groq:   https://console.groq.com/keys
# Nur einen Anbieter? Dann je ein Eintrag ohne ';'.
OPENAI_API_BASE_URLS=https://generativelanguage.googleapis.com/v1beta/openai/;https://api.groq.com/openai/v1
OPENAI_API_KEYS=DEIN_GEMINI_KEY;DEIN_GROQ_KEY

# ── Open WebUI ──
# Datenverzeichnis (SQLite usw.) im Repo, wird gitignored.
DATA_DIR=./data
# Port der Weboberfläche.
PORT=8080
# Eigener Login von Open WebUI an (erster registrierter Nutzer wird Admin).
WEBUI_AUTH=true
# Fester Secret-Key, damit Sitzungen einen Neustart überleben.
# Einmal erzeugen mit:  openssl rand -hex 32
WEBUI_SECRET_KEY=
